  <!-- =========================================================================
       6. Why Patna Signage? (Machine Advantage)
       ========================================================================= -->
  <section class="why-section" id="whyUs">
    <div class="container why-grid">
      <!-- Workshop Machine Photo & Advantage -->
      <div class="workshop-visual-column">
        <div class="workshop-img-card">
          <img 
            src="https://images.unsplash.com/photo-1581092160607-ee22621dd758?auto=format&fit=crop&w=1000&q=80" 
            alt="Patna Signage In-House CNC Laser Cutting and Fabrication Machine Workshop" 
            class="workshop-img"
          >
          <div class="workshop-overlay-stat">
            <div class="stat-item">
              <div class="stat-num">100%</div>
              <div class="stat-label">In-House Manufacturing</div>
            </div>
            <div class="stat-item">
              <div class="stat-num">0.1mm</div>
              <div class="stat-label">CNC Router Precision</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Process Content -->
      <div class="why-content-column">
        <span class="section-tag">In-House Machine Advantage</span>
        <h2 class="section-title">Designed. Manufactured. Installed.</h2>
        <p class="section-subtitle" style="margin: 0 0 24px 0;">
          From design to fabrication and installation, we manage your signage project under one roof. Unlike brokers who outsource your job, our full-fledged workshop in Patna handles every cut, bend, and weld directly.
        </p>

        <div class="process-steps-list">
          <div class="process-step-item">
            <div class="step-num-bubble">01</div>
            <div class="step-body">
              <h4 class="step-body-title">Design</h4>
              <p class="step-body-desc">Custom signage design based on your brand, architecture, and visibility requirements.</p>
            </div>
          </div>

          <div class="process-step-item">
            <div class="step-num-bubble">02</div>
            <div class="step-body">
              <h4 class="step-body-title">Production</h4>
              <p class="step-body-desc">In-house printing and fabrication capabilities using computerized machinery.</p>
            </div>
          </div>

          <div class="process-step-item">
            <div class="step-num-bubble">03</div>
            <div class="step-body">
              <h4 class="step-body-title">Finishing</h4>
              <p class="step-body-desc">Cutting, lettering, lighting and finishing with certified wiring and electrical testing.</p>
            </div>
          </div>

          <div class="process-step-item">
            <div class="step-num-bubble">04</div>
            <div class="step-body">
              <h4 class="step-body-title">Installation</h4>
              <p class="step-body-desc">Professional installation at your location anywhere in Patna and Bihar.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       7. Our Work / Portfolio (Light Gray Background #F1F1F1)
       ========================================================================= -->
  <section class="portfolio-section" id="portfolio">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Our Portfolio</span>
        <h2 class="section-title">Signage Projects That Speak for Your Brand</h2>
        <p class="section-subtitle">Browse through our recently completed commercial storefronts, illuminated LED letters, and corporate branding across Patna.</p>
      </div>

      <!-- Categories Filter Tabs -->
      <div class="portfolio-filter-bar">
        <button class="filter-btn active" data-filter="all">All</button>
        <button class="filter-btn" data-filter="led">LED</button>
        <button class="filter-btn" data-filter="acp">ACP</button>
        <button class="filter-btn" data-filter="3d">3D Letters</button>
        <button class="filter-btn" data-filter="shop">Shop Front</button>
        <button class="filter-btn" data-filter="corporate">Corporate</button>
      </div>

      <!-- Projects Grid (6-9 actual projects) -->
      <div class="portfolio-grid">
        <!-- Project 1 -->
        <div class="portfolio-item" data-category="led shop 3d">
          <div class="portfolio-img-wrap">
            <img src="https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?auto=format&fit=crop&w=800&q=80" alt="Apex Bistro LED Channel Letter Signage" class="portfolio-img">
            <span class="portfolio-category-badge">LED Channel Letters</span>
          </div>
          <div class="portfolio-info">
