<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Patna Signage | Premium LED Signage, 3D Letters & Storefront Fabrication in Patna</title>
  <meta name="description" content="Patna Signage is Bihar's leading in-house signage manufacturer. Custom LED channel letters, 3D acrylic & stainless steel letters, modern ACP facades, glow signs, and commercial storefront branding.">
  <meta name="keywords" content="Patna Signage, LED Sign Board Patna, 3D Letters Patna, ACP Sign Board Patna, Glow Sign Board Bihar, Signage Manufacturer Patna, Shop Front Branding Patna">
  
  <!-- Open Graph / Meta -->
  <meta property="og:type" content="website">
  <meta property="og:title" content="Patna Signage - Premium Signage That Makes Your Business Stand Out">
  <meta property="og:description" content="Custom LED Signage, 3D Letters, ACP Sign Boards & Complete Signage Fabrication in Patna. In-house production and professional installation.">
  <meta property="og:image" content="https://images.unsplash.com/photo-1555396273-367ea4eb4db5?auto=format&fit=crop&w=1200&q=80">

  <!-- Favicon with 3D P Icon -->
  <link rel="icon" type="image/svg+xml" href="assets/favicon.svg">
  <link rel="icon" type="image/png" href="assets/favicon.png">
  <link rel="apple-touch-icon" href="assets/favicon.png">

  <!-- Core CSS -->
  <link rel="stylesheet" href="css/styles.css">

  <!-- Structured Data: LocalBusiness Schema -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "Patna Signage",
    "image": "assets/patna-signage-logo.svg",
    "telephone": "+91 91234 56789",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Bailey Road / Exhibition Road",
      "addressLocality": "Patna",
      "addressRegion": "Bihar",
      "postalCode": "800001",
      "addressCountry": "IN"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": 25.6093,
      "longitude": 85.1235
    },
    "priceRange": "₹₹",
    "openingHoursSpecification": {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
      "opens": "09:30",
      "closes": "20:30"
    }
  }
  </script>
</head>
<body>

  <!-- =========================================================================
       1. Header (Black #111111 + Vector SVG Logo Lockup + Red CTA)
       ========================================================================= -->
  <header class="site-header" id="mainHeader">
    <div class="container header-container">
      <a href="#hero" class="brand-logo" aria-label="Patna Signage Home">
        <img src="assets/patna-signage-logo-light.svg" alt="Patna Signage - Signage | Branding | Fabrication" class="navbar-brand-img">
      </a>

      <!-- Desktop Navigation -->
      <nav class="main-nav" id="mainNav">
        <ul class="nav-links">
          <li><a href="#hero" class="nav-link active">Home</a></li>
          <li><a href="#featuredTypes" class="nav-link">Signage</a></li>
          <li><a href="#whatWeDo" class="nav-link">Services</a></li>
          <li><a href="#portfolio" class="nav-link">Projects</a></li>
          <li><a href="#about" class="nav-link">About</a></li>
          <li><a href="#contact" class="nav-link">Contact</a></li>
        </ul>
      </nav>

      <!-- Right Side CTA: 🔴 #E31B23 -->
      <div class="header-cta-group">
        <a href="#contact" class="header-quote-btn">
          <span>📞</span> Get a Quote
        </a>
        <button class="mobile-toggle" aria-label="Toggle Navigation Menu">☰</button>
      </div>
    </div>
  </header>

  <!-- =========================================================================
       2. Hero Section (Hero Background Image: assets/Hero background image.png)
       ========================================================================= -->
  <section class="hero-section" id="hero">
    <div class="container hero-content-wrap">
      <!-- Left Column: Copy & Live Text -->
      <div class="hero-text-col">
        <div class="hero-badge">
          <span class="pulse-dot"></span>
          Bihar's Premier Signage Manufacturer
        </div>

        <!-- Prominent Live Text Tagline -->
        <div class="hero-service-tagline">
          <span class="tag-pill tag-red">SIGNAGE</span>
          <span class="tag-dot">•</span>
          <span class="tag-pill tag-gold">BRANDING</span>
          <span class="tag-dot">•</span>
          <span class="tag-pill tag-dark">FABRICATION</span>
        </div>
        
        <h1 class="hero-title">
          Premium Signage That Makes Your Business <span class="highlight-red">Stand</span> <span class="highlight-gold">Out</span>
        </h1>
        
        <p class="hero-subtitle">
          Patna's leading in-house manufacturer of 3D Acrylic & LED Channel Letters, Modern ACP Facades, Glow Signs, and Commercial Storefront Fabrication. Built with CNC precision for maximum brand visibility.
        </p>

        <!-- 3 Pillars Live Text Chips -->
        <div class="hero-pillars-row">
          <a href="#whatWeDo" class="pillar-chip">
            <span class="pillar-chip-icon">💡</span>
            <div class="pillar-chip-text">
              <strong>Signage</strong>
              <span>LED & 3D Letters</span>
            </div>
          </a>
          <a href="#whatWeDo" class="pillar-chip">
            <span class="pillar-chip-icon">🎯</span>
            <div class="pillar-chip-text">
              <strong>Branding</strong>
              <span>Storefronts & Facades</span>
            </div>
          </a>
          <a href="#whatWeDo" class="pillar-chip">
            <span class="pillar-chip-icon">⚙️</span>
            <div class="pillar-chip-text">
              <strong>Fabrication</strong>
              <span>In-House CNC Cutting</span>
            </div>
          </a>
        </div>

        <div class="hero-actions">
          <a href="#contact" class="btn btn-primary">Get Free Quote →</a>
          <a href="#portfolio" class="btn btn-secondary">View Our Work</a>
        </div>

        <!-- Trust Points -->
        <div class="hero-trust-points">
          <div class="trust-item">
            <span class="trust-check">✓</span> In-House Production
          </div>
          <div class="trust-item">
            <span class="trust-check">✓</span> Custom Fabrication
          </div>
          <div class="trust-item">
            <span class="trust-check">✓</span> Installation Available
          </div>
          <div class="trust-item">
            <span class="trust-check">✓</span> Direct Factory in Patna
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       3. Quick Trust Bar (Signage • Branding • Fabrication Live Text)
       ========================================================================= -->
  <div class="quick-trust-bar">
    <div class="container trust-bar-wrap">
      <div class="trust-bar-message">
        <span class="pill">💡 <strong>SIGNAGE</strong></span>
        <span class="trust-divider">•</span>
        <span class="pill">🎯 <strong>BRANDING</strong></span>
        <span class="trust-divider">•</span>
        <span class="pill">⚙️ <strong>FABRICATION</strong></span>
        <span class="trust-divider">|</span>
        <span class="pill">🛡️ <strong>Direct Factory in Patna</strong></span>
      </div>
      <div class="trust-badge-mini">
        <span>🏭 No Brokers • In-House CNC & Laser Production in Bihar</span>
      </div>
    </div>
  </div>

  <!-- =========================================================================
       4. What We Do (Service Cards: White BG + Black Text + Red Accent)
       ========================================================================= -->
  <section class="services-section" id="whatWeDo">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Complete Signage Solutions</span>
        <h2 class="section-title">Complete Signage Solutions Under One Roof</h2>
        <p class="section-subtitle">From eye-catching luminous storefronts to corporate architectural branding, we craft every sign with industrial precision and premium materials.</p>
      </div>

      <div class="services-grid">
        <!-- 01 LED Signage -->
        <div class="service-card">
          <div class="service-img-wrap">
            <img src="https://images.unsplash.com/photo-1563245372-f21724e3856d?auto=format&fit=crop&w=600&q=80" alt="LED Signage Solutions Patna" class="service-img">
            <span class="service-num-badge">01</span>
          </div>
          <div class="service-card-top">
            <div class="service-icon-box">💡</div>
            <h3 class="service-card-title">LED Signage</h3>
          </div>
          <p class="service-card-desc">Channel letters, illuminated letters, glow signs and LED boards engineered with waterproof diode modules.</p>
          <a href="#contact" class="service-card-link">Explore LED Options →</a>
        </div>

        <!-- 02 3D Letter Signage -->
        <div class="service-card">
          <div class="service-img-wrap">
            <img src="https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=600&q=80" alt="3D Letter Signage Fabrication" class="service-img">
            <span class="service-num-badge">02</span>
          </div>
          <div class="service-card-top">
            <div class="service-icon-box">🔤</div>
            <h3 class="service-card-title">3D Letter Signage</h3>
          </div>
          <p class="service-card-desc">Acrylic, stainless steel, aluminium and premium 3D letters crafted with precision computerized bending and laser cutting.</p>
          <a href="#contact" class="service-card-link">Explore 3D Letters →</a>
        </div>

        <!-- 03 ACP Signage -->
        <div class="service-card">
          <div class="service-img-wrap">
            <img src="https://images.unsplash.com/photo-1572945550744-57049dcbc1b3?auto=format&fit=crop&w=600&q=80" alt="ACP Signage Facade Patna" class="service-img">
            <span class="service-num-badge">03</span>
          </div>
          <div class="service-card-top">
            <div class="service-icon-box">🏢</div>
            <h3 class="service-card-title">ACP Signage</h3>
          </div>
          <p class="service-card-desc">Modern ACP shop fronts, corporate signage and facade branding using heavy-duty aluminium composite panels.</p>
          <a href="#contact" class="service-card-link">Explore ACP Solutions →</a>
        </div>

        <!-- 04 Glow Sign Boards -->
        <div class="service-card">
          <div class="service-img-wrap">
            <img src="https://images.unsplash.com/photo-1550989460-0adf9ea622e2?auto=format&fit=crop&w=600&q=80" alt="Glow Sign Boards Patna" class="service-img">
            <span class="service-num-badge">04</span>
          </div>
          <div class="service-card-top">
            <div class="service-icon-box">✨</div>
            <h3 class="service-card-title">Glow Sign Boards</h3>
          </div>
          <p class="service-card-desc">Durable and highly visible illuminated boards built for commercial reliability and high contrast readability.</p>
          <a href="#contact" class="service-card-link">Explore Glow Boards →</a>
        </div>

        <!-- 05 Shop Front Signage -->
        <div class="service-card">
          <div class="service-img-wrap">
            <img src="https://images.unsplash.com/photo-1555396273-367ea4eb4db5?auto=format&fit=crop&w=600&q=80" alt="Shop Front Signage Patna" class="service-img">
            <span class="service-num-badge">05</span>
          </div>
          <div class="service-card-top">
            <div class="service-icon-box">🏬</div>
            <h3 class="service-card-title">Shop Front Signage</h3>
          </div>
          <p class="service-card-desc">Complete storefront branding and signage solutions that convert passing foot traffic into paying customers across Patna.</p>
          <a href="#contact" class="service-card-link">Explore Shop Fronts →</a>
        </div>

        <!-- 06 Corporate Signage -->
        <div class="service-card">
          <div class="service-img-wrap">
            <img src="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=600&q=80" alt="Corporate Signage Patna" class="service-img">
            <span class="service-num-badge">06</span>
          </div>
          <div class="service-card-top">
            <div class="service-icon-box">🏛️</div>
            <h3 class="service-card-title">Corporate Signage</h3>
          </div>
          <p class="service-card-desc">Office, showroom, hospital, school and commercial architectural signage.</p>
          <a href="#contact" class="service-card-link">Explore Corporate →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
