            <div class="portfolio-type">LED Channel Letter Signage</div>
            <div class="portfolio-location">📍 Boring Road, Patna</div>
          </div>
        </div>

        <!-- Project 2 -->
        <div class="portfolio-item" data-category="acp shop">
